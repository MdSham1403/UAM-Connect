# UAM Connect — environment template (placeholders only).
# Copy to .env.local (git-ignored). NEVER commit real values.

# --- Frontend (public by design; data is protected by RLS) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Phase 5 (Web Push): public VAPID key only
VITE_VAPID_PUBLIC_KEY=

# --- Server-side secrets: DO NOT put these in this file or any VITE_ variable ---
# Set them only as Supabase Edge Function secrets / the provider's secret store:
#   SUPABASE_SERVICE_ROLE_KEY
#   VAPID_PRIVATE_KEY
#   VAPID_SUBJECT   (e.g. mailto:owner@example.com)

# --- Tests (use a separate git-ignored file such as .env.test.local) ---
# E2E_BASE_URL=http://localhost:5173
# E2E_MEMBER_EMAIL=
# E2E_ADMIN_EMAIL=
